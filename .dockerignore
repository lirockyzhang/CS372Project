# Keep the build context small and exclude things we don't ship.
.git
.gitattributes
.gitignore
.venv
.claude
.python-version

# Training artifacts and datasets — irrelevant to serving.
runs
data
docs
videos

# All checkpoints except the one the Dockerfile copies explicitly.
models/transformer
models/ppo
models/cnn/iter_*
models/cnn/cnn_c128b3_100k_best.pt
models/cnn/cnn_c128b3_100k_final.pt
models/cnn/cnn_c128b3_100k_reg.pt

# Python build/test detritus.
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Repo-level files we don't need at runtime.
uv.lock
pyproject.toml
main.py
ATTRIBUTION.md
README.md
SETUP.md
